parameters:
  paths:
    - src
  level: max
  bootstrapFiles:
    - vendor/autoload.php
  scanDirectories:
    - phar://%currentWorkingDirectory%/vendor/BedrockEconomy.phar/src/
    - phar://%currentWorkingDirectory%/vendor/EconomyAPI.phar/src/
    - phar://%currentWorkingDirectory%/vendor/SimpleEconomy.phar/src/
  excludePaths:
    analyse:
     - vendor
